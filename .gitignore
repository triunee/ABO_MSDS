# 원본 PDF (저작권 — 출처는 data/sources.csv의 url 칸에만 기록)
data/raw/*
!data/raw/.gitkeep
*.pdf

# 학습 결과물 — 가중치·체크포인트만 제외하고 config.json·loss 로그는 커밋
runs/**/*.safetensors
runs/**/*.bin
runs/**/*.gguf
runs/**/checkpoint-*/

# 비밀키·환경
.env
.env.local
.venv/
venv/

# 파이썬 캐시
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/

# IDE·OS
.vscode/settings.json
.idea/
.DS_Store

# 프런트엔드 빌드 결과
web/dist/

# W&B 로컬 기록(scripts/wandb_watch.py)
wandb/


# PDF → SQLite 적재 결과물 (app/pipeline_run.py)
data/db/
data/rag/
outputs/exports/

# 배포 경량화 트랙
.venv-quark/
runs/deploy/
runs/deploy_smoke/
# 병합본 · 양자화본 · 어댑터 폴더째 제외(기록 json · log만 커밋, docs/deploy_quant_plan.md 6절)
runs/**/merged*/
runs/**/quark_*/
runs/**/adapter/

# 그룹 교차검증(eval/cv.py) — fold 학습셋 · 어댑터 · 모은 출력 사본 · 실행 로그는 커밋하지 않음
cv/data/
cv/runs/**/adapter/
cv/pooled/
cv/logs/
cv/.lock
cv/*.out
cv/perturb/text/
cv/perturb/pooled/
cv/perturb/.lock
cv/perturb/*.out
